root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 160
# Composable functions use PascalCase by Compose convention; ktlint's function-naming
# rule doesn't recognise @Composable, so disable it project-wide.
ktlint_standard_function-naming = disabled

[*.{yml,yaml,json,toml}]
indent_size = 2
